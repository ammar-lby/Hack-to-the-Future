{
  "name": "voice-speak",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "voice-speak",
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-speak",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "name": "Pick voice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || {};\nconst language = body.language === 'en' ? 'en' : 'ar';\nconst text = String(body.text || '').trim();\nif (!text) throw new Error('empty_text');\n\nconst voices = { ar: 'b9d91X97oYW3JwsztH2K', en: 'wDkXkmTqABGFuqM5TDga' };\nconst voiceId = voices[language];\n\nreturn [{ json: { text, language, voiceId } }];"
      }
    },
    {
      "name": "ElevenLabs TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Header Auth account"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "=https://api.elevenlabs.io/v1/text-to-speech/{{ $json.voiceId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, model_id: 'eleven_v3' }) }}",
        "options": {
          "response": {
            "response": {
              "outputPropertyName": "data",
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "name": "To base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst prev = $('Pick voice').first().json;\nreturn [{ json: { audio: buf.toString('base64'), language: prev.language } }];"
      }
    },
    {
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "position": [
        896,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Pick voice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick voice": {
      "main": [
        [
          {
            "node": "ElevenLabs TTS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ElevenLabs TTS": {
      "main": [
        [
          {
            "node": "To base64",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "To base64": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "note": "Export of the live workflow on futureyou.app.n8n.cloud (built by Ibrahim). After import, re-select the ElevenLabs Header Auth credential (header xi-api-key). Contains no secrets."
  }
}
